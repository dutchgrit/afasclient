<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>DutchGrit.Afas</RootNamespace>
    <AssemblyName>DutchGrit.AfasClient</AssemblyName>
    <Company>DutchGrit - Lucrasoft Digital BV</Company>
    <Copyright>Lucrasoft Digital BV</Copyright>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>DutchGrit</Authors>
    <Description>.NET Standard 2.1 Library for interacting with the AFAS (Profit) RestAPI</Description>
    <PackageTags>AFAS;Profit;RestAPI</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReleaseNotes>Added AfasClient.UsingAuthentication to use a custom IAfasAuthentication strategy; the authentication constructor is now also available to subclasses. ClientCredentialsAuthentication considers a token expired 25% of its lifetime (at most 60 seconds) before it expires, so short-lived tokens are cached as well, and its exceptions contain only the HTTP status and the OAuth error code, never the response body. Corrected the classic token dates: existing classic tokens expire on 1 May 2027, and app connectors that use a classic token stop working after 31 August 2027.</PackageReleaseNotes>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0.0</Version>
    <PackageProjectUrl>https://github.com/dutchgrit/afasclient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dutchgrit/afasclient</RepositoryUrl>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Images\" />
  </ItemGroup>

</Project>
